    <string name="step_open">Abrir ajustes</string>
    <string name="step_role_title">Reconocer llamadas</string>
    <string name="step_role_text">Elige Call2Chat como «App de identificación de llamadas y spam». Android solo le avisará de los números que no están en tus contactos.\n\nNunca bloquea, graba ni escucha llamadas.</string>
    <string name="step_role_btn">Configurar Call2Chat</string>
    <string name="step_sims_title">¿En qué números?</string>
    <string name="step_sims_text">Tu teléfono tiene dos SIM. Elige en qué números activar Call2Chat y con qué app responde cada una.</string>
    <string name="step_sims_btn">Permitir reconocer la SIM</string>
    <string name="sims_none">No se encontró ninguna SIM activa</string>
    <string name="sims_pick">Elige la SIM</string>
    <string name="sim_label">SIM %1$d</string>
    <string name="sim_reply_with">Responde con %1$s</string>
    <string name="sim_off">desactivada</string>
    <string name="sim_turn_off">Desactivar en esta SIM</string>
    <string name="sim_turn_on">Activar en esta SIM</string>
    <string name="step_channel_title">¿Qué WhatsApp?</string>
    <string name="step_channel_text">Tienes WhatsApp y WhatsApp Business. Elige con cuál responder a los desconocidos. Puedes cambiarlo cuando quieras.</string>
    <string name="step_notif_title">Notificaciones</string>
    <string name="step_notif_text">Sirven para avisarte con el mensaje listo cuando alguien te llama.</string>
    <string name="step_notif_btn">Permitir notificaciones</string>
    <string name="step_overlay_title">Botón durante la llamada</string>
    <string name="step_overlay_text">Activa «Mostrar sobre otras apps» para Call2Chat: mientras suena el teléfono aparecerá la tarjeta Enviar.</string>
    <string name="step_keep_title">No pausar la app</string>
    <string name="step_keep_text">Desactiva «Pausar actividad si no se usa». Si no, Android la detiene tras unas semanas.</string>
    <string name="step_battery_title">Batería sin límites</string>
    <string name="step_battery_text">Abre «Batería» y elige «Sin restricciones», para que Call2Chat funcione con la app cerrada.\n\nLuego vuelve y toca Hecho.</string>
    <string name="step_xiaomi_title">Permisos de Xiaomi</string>
    <string name="step_xiaomi_text">Activa:\n• Inicio automático\n• Mostrar ventanas emergentes en segundo plano\n• Mostrar en la pantalla de bloqueo\n\nLuego vuelve y toca Hecho.</string>
    <string name="step_samsung_title">Samsung: sin suspensión</string>
    <string name="step_samsung_text">En «Batería» elige «Sin restricciones».\n\nSi Call2Chat está entre las «Aplicaciones en suspensión» (Mantenimiento → Batería → Límites de uso en segundo plano), quítala.\n\nLuego vuelve y toca Hecho.</string>
    <string name="step_oppo_title">Inicio automático</string>
    <string name="step_oppo_text">Activa «Inicio automático» (o «Permitir actividad en segundo plano») para Call2Chat.\n\nLuego vuelve y toca Hecho.</string>
    <string name="step_vivo_title">Inicio en segundo plano</string>
    <string name="step_vivo_text">Permite a Call2Chat iniciarse sola y funcionar en segundo plano.\n\nLuego vuelve y toca Hecho.</string>
    <string name="step_huawei_title">Inicio de apps</string>
    <string name="step_huawei_text">En «Inicio de aplicaciones» pon Call2Chat en «Gestionar manualmente» y activa los tres interruptores.\n\nLuego vuelve y toca Hecho.</string>
