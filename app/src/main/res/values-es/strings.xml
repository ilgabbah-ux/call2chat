    <string name="setup_done_title">¡Todo listo!</string>
    <string name="setup_done_text">Call2Chat funciona incluso con la app cerrada. Cuando te llama un número que no está en tus contactos, aparece la tarjeta Enviar sobre la llamada.</string>
    <string name="setup_partial_title">Casi listo</string>
    <string name="setup_partial_text">Te saltaste algunos pasos: con la app cerrada podría no avisarte. Complétalos cuando quieras desde la tarjeta de arriba.</string>
    <string name="setup_tip_recents">Consejo: abre las apps recientes, mantén pulsada Call2Chat y toca el candado para que no se cierre.</string>
