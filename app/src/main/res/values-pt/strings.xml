    <string name="step_role_title">Reconhecer chamadas</string>
    <string name="step_role_text">Escolha o Call2Chat como «App de identificação de chamadas e spam». O Android só lhe indicará números que não estão nos seus contatos.\n\nNunca bloqueia, grava ou ouve chamadas.</string>
    <string name="step_role_btn">Definir Call2Chat</string>
    <string name="step_sims_title">Em que números?</string>
    <string name="step_sims_text">O seu telefone tem dois SIM. Escolha em que números ativar o Call2Chat e com que app responde cada um.</string>
    <string name="step_sims_btn">Permitir reconhecer o SIM</string>
    <string name="sims_none">Nenhum SIM ativo encontrado</string>
    <string name="sims_pick">Escolha o SIM</string>
