    <string name="sim_turn_on">Ativar neste SIM</string>
    <string name="step_channel_title">Qual WhatsApp?</string>
    <string name="step_channel_text">Tem o WhatsApp e o WhatsApp Business. Escolha com qual responder a desconhecidos. Pode mudar quando quiser.</string>
    <string name="step_notif_title">Notificações</string>
    <string name="step_notif_text">Servem para o avisar com a mensagem pronta quando alguém liga.</string>
    <string name="step_notif_btn">Permitir notificações</string>
    <string name="step_overlay_title">Botão durante a chamada</string>
    <string name="step_overlay_text">Ative «Mostrar sobre outras apps» para o Call2Chat: enquanto o telefone toca aparece o cartão Enviar.</string>
    <string name="step_keep_title">Não pausar a app</string>
    <string name="step_keep_text">Desative «Pausar atividade da app se não for usada». Caso contrário, o Android para-a após algumas semanas.</string>
    <string name="step_battery_title">Bateria sem restrições</string>
    <string name="step_battery_text">Abra «Bateria» e escolha «Sem restrições», para o Call2Chat funcionar com a app fechada.\n\nDepois volte e toque em Feito.</string>
    <string name="step_xiaomi_title">Permissões Xiaomi</string>
    <string name="step_xiaomi_text">Ative:\n• Arranque automático\n• Mostrar janelas pop-up em segundo plano\n• Mostrar no ecrã de bloqueio\n\nDepois volte e toque em Feito.</string>
    <string name="step_samsung_title">Samsung: sem suspensão</string>
    <string name="step_samsung_text">Em «Bateria» escolha «Sem restrições».\n\nSe o Call2Chat estiver nas «Apps em suspensão» (Assistência do dispositivo → Bateria → Limites de utilização em segundo plano), remova-o.\n\nDepois volte e toque em Feito.</string>
    <string name="step_oppo_title">Arranque automático</string>
    <string name="step_oppo_text">Ative «Arranque automático» (ou «Permitir atividade em segundo plano») para o Call2Chat.\n\nDepois volte e toque em Feito.</string>
    <string name="step_vivo_title">Arranque em segundo plano</string>
    <string name="step_vivo_text">Permita ao Call2Chat arrancar sozinho e funcionar em segundo plano.\n\nDepois volte e toque em Feito.</string>
    <string name="step_huawei_title">Arranque de apps</string>
    <string name="step_huawei_text">Em «Arranque de apps» defina o Call2Chat para «Gerir manualmente» e ative os três interruptores.\n\nDepois volte e toque em Feito.</string>
