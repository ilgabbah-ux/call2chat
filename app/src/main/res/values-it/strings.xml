    <string name="step_role_title">Riconosci le chiamate</string>
    <string name="step_role_text">Scegli Call2Chat come «App ID chiamante e spam». Android le segnalerà solo i numeri che non hai in rubrica.\n\nNon blocca, non registra e non ascolta nessuna chiamata.</string>
    <string name="step_role_btn">Imposta Call2Chat</string>
    <string name="step_sims_title">Su quali numeri?</string>
    <string name="step_sims_text">Il tuo telefono ha due SIM. Scegli su quali numeri attivare Call2Chat e con quale app risponde ognuna.</string>
    <string name="step_sims_btn">Consenti di riconoscere la SIM</string>
    <string name="sims_none">Nessuna SIM attiva trovata</string>
    <string name="sims_pick">Scegli la SIM</string>
