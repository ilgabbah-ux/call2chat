    <string name="setup_done_title">Tutto pronto!</string>
    <string name="setup_done_text">Call2Chat funziona anche ad app chiusa. Quando ti chiama un numero che non hai in rubrica, sopra la chiamata compare la scheda con Invia.</string>
    <string name="setup_partial_title">Quasi pronto</string>
    <string name="setup_partial_text">Hai saltato qualche passaggio: ad app chiusa l\'app potrebbe non avvisarti. Puoi completarli quando vuoi dalla scheda in alto.</string>
