    <string name="step_channel_title">Which WhatsApp?</string>
    <string name="step_channel_text">You have both WhatsApp and WhatsApp Business. Choose which one replies to unknown callers. You can change it later.</string>
    <string name="step_notif_title">Notifications</string>
    <string name="step_notif_text">Needed to alert you with the ready message when someone calls.</string>
    <string name="step_notif_btn">Allow notifications</string>
    <string name="step_overlay_title">Button during the call</string>
    <string name="step_overlay_text">Turn on «Display over other apps» for Call2Chat: while the phone rings, the Send card appears.</string>
    <string name="step_keep_title">Don\'t pause the app</string>
    <string name="step_keep_text">Turn off «Pause app activity if unused». Otherwise Android stops it after a few weeks.</string>
    <string name="step_battery_title">Unrestricted battery</string>
    <string name="step_battery_text">Open «Battery» and choose «Unrestricted», so Call2Chat works even when closed.\n\nThen come back and tap Done.</string>
    <string name="step_xiaomi_title">Xiaomi permissions</string>
    <string name="step_xiaomi_text">Turn on:\n• Autostart\n• Display pop-up windows while running in the background\n• Show on lock screen\n\nThen come back and tap Done.</string>
    <string name="step_samsung_title">Samsung: no sleeping</string>
    <string name="step_samsung_text">In «Battery» choose «Unrestricted».\n\nIf Call2Chat is among «Sleeping apps» (Device care → Battery → Background usage limits), remove it.\n\nThen come back and tap Done.</string>
    <string name="step_oppo_title">Auto launch</string>
    <string name="step_oppo_text">Turn on «Auto launch» (or «Allow background activity») for Call2Chat.\n\nThen come back and tap Done.</string>
    <string name="step_vivo_title">Background start</string>
    <string name="step_vivo_text">Allow Call2Chat to auto-start and run in the background.\n\nThen come back and tap Done.</string>
    <string name="step_huawei_title">App launch</string>
    <string name="step_huawei_text">In «App launch» set Call2Chat to «Manage manually» and turn on all three switches.\n\nThen come back and tap Done.</string>
