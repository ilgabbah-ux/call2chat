    <string name="step_role_title">Recognise calls</string>
    <string name="step_role_text">Choose Call2Chat as «Caller ID &amp; spam app». Android will only tell it about numbers not in your contacts.\n\nIt never blocks, records or listens to calls.</string>
    <string name="step_role_btn">Set Call2Chat</string>
    <string name="step_sims_title">Which numbers?</string>
    <string name="step_sims_text">Your phone has two SIMs. Choose on which numbers Call2Chat is active and which app replies for each one.</string>
