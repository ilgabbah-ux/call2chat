<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#0F8B6F</color>
    <color name="brand_dark">#0A5E4B</color>
    <color name="accent">#FFC531</color>
    <color name="icon_bg">#0F8B6F</color>

    <style name="Theme.Call2Chat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
