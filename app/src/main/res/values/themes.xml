<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Call2Chat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/surface2</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorOnSecondary">@color/on_yellow</item>
        <item name="colorSecondaryContainer">@color/surface2</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text3</item>
        <item name="colorSurfaceContainerHighest">@color/surface2</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOutline">@color/outline_variant</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="materialAlertDialogTheme">@style/Dialog.Call2Chat</item>
    </style>

    <style name="Dialog.Call2Chat" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Schede -->
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Testi -->
    <style name="H1">
        <item name="android:fontFamily">@font/grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="CardTitle">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text3</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="BigNumber">
        <item name="android:fontFamily">@font/grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Pulsanti -->
    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
    </style>
    <style name="Btn.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/surface2</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Btn.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Btn.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text3</item>
    </style>
</resources>
